#!/usr/bin/env bash

# Student Details
# Name : Yogender
# Student ID: 23871801

# Define a log file for git output
git_log_file="git.log"

# Check that both input and output file names are provided
if [ "$#" -ne 1 ]; then
  echo "Error: Input file name is required" >&2
  exit 1
fi

input_file="$1"

# Check that the input file exists
if [ ! -f "$input_file" ]; then
  echo "Error: Input file not found" >&2
  exit 1
fi

# Initialize Git repository
git init > "$git_log_file" 2>&1
git add . >> "$git_log_file" 2>&1
git commit -m "Initial commit" >> "$git_log_file" 2>&1

# Create a new branch for this run
git checkout -b "$(date +%Y%m%d%H%M%S)" >> "$git_log_file" 2>&1

# Define headers
headers=("Name_of_Covered_Entity" "State" "Individuals_Affected" "Date_of_Breach" "Type_of_Breach" "Month" "Year")

# Print the headers
printf "%s\t" "${headers[@]}"
echo ""

# Read the data lines and add the month and year columns
sed 1d "$input_file" | while IFS=$'\t' read -r name_of_entity state affected date_of_breach type_of_breach _ _; do

  # Check the field count
  if [ "${#date_of_breach}" -lt 4 ]; then
    echo "Skipping line with erroneous data: $name_of_entity" >&2
    continue
  fi
  
  # Extract the month and year from the date field
  if [[ "$date_of_breach" == *-* ]]; then
    # Date range
    start_date=$(echo "$date_of_breach" | cut -d'-' -f1)
    month=$(date -d "$start_date" +"%-m")
    year=$(date -d "$start_date" +"%Y")
  else
    # Single date
    month=$(date -d "$date_of_breach" +"%-m")
    year=$(date -d "$date_of_breach" +"%Y")
  fi
  
  # Remove everything after the first comma or slash in Type_of_Breach field
  type_of_breach="${type_of_breach%%[,/]*}"
  
  # Print the line with the new fields
  printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n" "$name_of_entity" "$state" "$affected" "$date_of_breach" "$type_of_breach" "$month" "$year"
done

# Add all new changes to the Git repository and commit them
git add -A >> "$git_log_file" 2>&1
git commit -m "Added calculations for $(date +%Y%m%d%H%M%S)" >> "$git_log_file" 2>&1

